#!/bin/sh
set -eu

if command -v python >/dev/null 2>&1; then
  python Tools/GitHooks/check_unreal_python_uv_safety.py
elif command -v py >/dev/null 2>&1; then
  py -3 Tools/GitHooks/check_unreal_python_uv_safety.py
else
  echo "Python is required for the Unreal Python UV safety pre-commit hook." >&2
  exit 1
fi
