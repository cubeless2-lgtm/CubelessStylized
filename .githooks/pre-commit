#!/bin/sh
set -eu

run_python_hook() {
  script="$1"
  if command -v python >/dev/null 2>&1; then
    python "$script"
  elif command -v py >/dev/null 2>&1; then
    py -3 "$script"
  else
    echo "Python is required for the Cubeless pre-commit hooks." >&2
    exit 1
  fi
}

run_python_hook Tools/GitHooks/check_unreal_python_uv_safety.py
run_python_hook Tools/GitHooks/check_no_project_mcp_plugin_dependency.py
