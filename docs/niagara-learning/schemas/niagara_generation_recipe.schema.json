{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubeless.local/schemas/niagara_generation_recipe.schema.json",
  "title": "Cubeless Niagara Generation Recipe",
  "type": "object",
  "required": [
    "schema_version",
    "request",
    "write_scope",
    "reference_analysis",
    "layers",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request": {
      "type": "string"
    },
    "parsed_intent": {
      "type": "object",
      "properties": {
        "visual_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_match_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "write_scope": {
      "type": "object",
      "required": [
        "temporary_root",
        "production_root",
        "source_policy"
      ],
      "properties": {
        "temporary_root": {
          "type": "string"
        },
        "production_root": {
          "type": "string"
        },
        "source_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reference_analysis": {
      "type": "object",
      "properties": {
        "primary_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renderer_material_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stack_control_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "module_input_control_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "module_input_control_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bp_linkage_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scratch_pad_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "renderer_analysis": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "system_path": {
          "type": "string"
        },
        "emitter_count": {
          "type": "number"
        },
        "renderer_count": {
          "type": "number"
        },
        "error": {
          "type": "string"
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "renderer_materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "stack_analysis": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "system_path": {
          "type": "string"
        },
        "emitter_count": {
          "type": "number"
        },
        "system_script_count": {
          "type": "number"
        },
        "system_scratch_pad_count": {
          "type": "number"
        },
        "total_scratch_pad_count": {
          "type": "number"
        },
        "total_emitter_function_call_count": {
          "type": "number"
        },
        "control_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scratch_pad_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        },
        "emitters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "module_input_analysis": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "system_path": {
          "type": "string"
        },
        "emitter_count": {
          "type": "number"
        },
        "include_resolved_stack_inputs": {
          "type": "boolean"
        },
        "module_count": {
          "type": "number"
        },
        "candidate_count": {
          "type": "number"
        },
        "top_candidate_count": {
          "type": "number"
        },
        "can_author_module_inputs": {
          "type": "boolean"
        },
        "authoring_status": {
          "type": "string"
        },
        "control_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_emitters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "top_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "resolved_input_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "error": {
          "type": "string"
        },
        "emitters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "operation",
          "source"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "duplicate_system",
              "duplicate_emitter",
              "reuse_source_as_reference",
              "add_primitive",
              "defer_until_api_available"
            ]
          },
          "source": {
            "type": "string"
          },
          "target_emitter": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "material_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "operation",
          "source_material"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "reuse",
              "duplicate_material_instance",
              "create_from_stylized_master",
              "defer_until_material_analysis"
            ]
          },
          "source_material": {
            "type": "string"
          },
          "target_material": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "renderer_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "parameter_overrides": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "user_parameters": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array",
          "object",
          "null"
        ]
      }
    },
    "generation_plan": {
      "type": "object",
      "required": [
        "target_system",
        "can_execute_now",
        "blocked_by_api",
        "preview_after_generation",
        "promotion_gate"
      ],
      "properties": {
        "target_system": {
          "type": "string"
        },
        "can_execute_now": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "source",
              "target"
            ],
            "properties": {
              "step": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "requires_mcp_command": {
                "type": "string"
              },
              "execution_mode": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "blocked_by_api": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "source",
              "missing_api"
            ],
            "properties": {
              "step": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "missing_api": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "preview_after_generation": {
          "type": "object",
          "required": [
            "tool",
            "fallback_tool",
            "rule"
          ],
          "properties": {
            "tool": {
              "type": "string"
            },
            "fallback_tool": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "promotion_gate": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
          "preview_frames_seconds": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "review_map": {
            "type": "string"
          },
          "preview_system": {
            "type": "string"
          },
          "camera_bookmarks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "quick_preview_fallback": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quick_preview_rule": {
            "type": "string"
          },
          "video_review_rule": {
            "type": "string"
          },
          "map_reload_safety_rule": {
            "type": "string"
          },
          "review_gate": {
            "type": "string"
          }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
